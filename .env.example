# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Weaviate API keys (Session 7). Never commit real values; see docs/security.md.
# Admin (root) key: ingestion, scripts/setup_access.py and the insecure v0-v4 stages.
# Create it with: python scripts/setup_access.py --init-admin-key
WEAVIATE_ADMIN_KEY=your-weaviate-admin-key-here
# Written by scripts/setup_access.py: customer-bot (public collection only) and
# agent-copilot (public + internal).
WEAVIATE_CUSTOMER_KEY=written-by-setup-access
WEAVIATE_AGENT_KEY=written-by-setup-access
